# Port configuration
PORT=5000
NODE_ENV=development

# Database connection details (PostgreSQL)
DATABASE_URL=postgresql://renttruth_user:renttruth_secure_pass@localhost:5432/renttruth_db

# Redis endpoint for caching
REDIS_URL=redis://localhost:6379

# JSON Web Token secret configuration (JWT)
JWT_ACCESS_SECRET=your_super_secret_access_token_key_goes_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_goes_here
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# bkash API credentials (Escrow & direct mobile payments)
BKASH_API_URL=https://checkout.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_bkash_sandbox_app_key
BKASH_APP_SECRET=your_bkash_sandbox_app_secret
BKASH_USERNAME=your_bkash_sandbox_username
BKASH_PASSWORD=your_bkash_sandbox_password

# Nagad API credentials
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_APP_KEY=your_nagad_app_key

# Supabase fallback database endpoint (Optional DBaaS sync)
SUPABASE_URL=https://your_supabase_project_url.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
